{
  "_version": "1.86.0",
  "sap.app": {
    "id": "superusermanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "Super User Management",
    "description": "Application",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZFCP_USER_MANAGEMENT_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [
            "localAnnotations"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "localAnnotations": {
        "uri": "annotations/annotation.xml",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": {
      "viewName": "superusermanagement.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.71.77",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.comp": {},
        "sap.ui.table": {}

      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "superusermanagement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "superusermanagement.view",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": "",
          "target": ["TargetMain"]
        },
        {
          "name": "RouteObjectPage",
          "pattern": "FCPUserSet/{emailPath}",
          "target": ["TargetObjectPage"]
        }
      ],
      "targets": {
        "TargetMain": {
          "viewType": "XML",
          "viewLevel": 1,
          "viewId": "Main",
          "viewName": "Main"
        },
        "TargetObjectPage": {
          "viewType": "XML",
          "viewLevel": 2,
          "viewId": "ObjectPage",
          "viewName": "ObjectPage"
        }
      }
    },
    "resources": {
        "css": [
            {
                "uri": "css/style.css"
            }
        ]
    }
  }
}